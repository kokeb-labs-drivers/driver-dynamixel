/**
 * @file dynamixel_version.h
 * @brief DYNAMIXEL driver version, generated by CMake from dynamixel_version.h.in.
 * @copyright Copyright (c) 2026 The driver-dynamixel authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/dynamixel_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef DYNAMIXEL_VERSION_H
#define DYNAMIXEL_VERSION_H

/** Major version: incompatible API changes. */
#define DYNAMIXEL_VERSION_MAJOR @DYNAMIXEL_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define DYNAMIXEL_VERSION_MINOR @DYNAMIXEL_VERSION_MINOR@
/** Patch version: fixes. */
#define DYNAMIXEL_VERSION_PATCH @DYNAMIXEL_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define DYNAMIXEL_VERSION_STRING "@DYNAMIXEL_VERSION@"

#endif // DYNAMIXEL_VERSION_H
